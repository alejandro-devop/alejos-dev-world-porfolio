# ─── Admin API (content source) ─────────────────────────────────────────────
# Base URL of the admin API — must include http:// or https:// (no /api suffix).
# Production (default for portfolio-only dev):
BACKEND_URL=https://your-admin-api.a.run.app
# Local API (with `pnpm dev:local-api` or full platform from repo root):
# BACKEND_URL=http://localhost:8080
# When unset, all content falls back to src/data/{locale}/*.json (no API).
# With BACKEND_URL set, sections in BACKEND_SECTIONS load from the API (default: all main homepage sections).

# API key for reading content (X-API-Key header).
# Generate one with: pnpm seed (in alejos-dev-world-admin)
BACKEND_API_KEY=

# Comma-separated sections to load from the API (phased rollout).
# Default when unset: hero,about,skills,experience,projects,services,testimonials
# BACKEND_SECTIONS=hero,about,skills,experience,projects,services,testimonials

# Fetch cache for API content (Next.js Data Cache):
# - unset + development → no cache (changes show immediately)
# - unset + production → ISR every 60s
# - 0 → always fresh (no-store), any environment
# - N → ISR every N seconds
# BACKEND_REVALIDATE_SECONDS=60

# Secret for POST /api/revalidate (on-demand cache purge after admin saves).
# REVALIDATE_SECRET=your-long-random-secret
